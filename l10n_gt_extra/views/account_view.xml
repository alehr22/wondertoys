<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="l10n_gt_view_move_form" model="ir.ui.view">
            <field name="name">l10n_gt_extra.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                    <field name="tipo_gasto"/>
                    <field name="nota_debito"/>
                    <field name="diario_facturas_por_rangos" invisible="1"/>
                    <field name="serie_rango" invisible="not diario_facturas_por_rangos"/>
                    <field name="inicial_rango" invisible="not diario_facturas_por_rangos"/>
                    <field name="final_rango" invisible="not diario_facturas_por_rangos"/>
                </xpath>
            </field>
        </record>

        <record id="l10n_gt_view_account_payment_form" model="ir.ui.view">
            <field name="name">l10n_gt_extra.account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="anular" string="Anular" type="object" invisible="state not in ('in_process', 'paid')"/>
                </header>
                <xpath expr="//group[@name='main_group']" position="inside">
                    <group>
                        <field name="anulado" readonly="1"/>
                        <field name="fecha_anulacion" readonly="1"/>
                        <field name="descripcion"/>
                        <field name="numero_viejo" invisible="state != 'draft'" readonly="1"/>
                        <field name="nombre_impreso"/>
                        <field name="no_negociable"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="l10n_gt_view_account_supplier_payment_tree" model="ir.ui.view">
            <field name="name">l10n_gt_extra.account.supplier.payment.list</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="fecha_anulacion" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="l10n_gt_view_account_journal_form" model="ir.ui.view">
            <field name="name">l10n_gt_extra.view_account_journal_form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Extra" name="l10n_gt_extra">
                        <group name="extra" string="Extra">
                            <group>
                                <field name="direccion" invisible="type not in ['sale', 'purchase']"/>
                                <field name="codigo_establecimiento" invisible="type not in ['sale', 'purchase']"/>
                                <field name="facturas_por_rangos" invisible="type != 'sale'"/>
                                <field name="usar_referencia" invisible="type != 'sale'"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
